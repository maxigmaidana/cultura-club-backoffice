# Supabase Configuration
# Obtén estos valores desde tu proyecto en https://app.supabase.com

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon/Publishable key de Supabase (safe for client-side)
# NO uses la service_role key aquí
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Nota para desarrollo:
# Copia este archivo a .env.local y completa con tus valores
# El archivo .env.local está en .gitignore y nunca se commitea
